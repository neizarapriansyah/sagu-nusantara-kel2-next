# koneksi database Prisma Postgres.
# ambil di Prisma Console: buka database -> Connect to your database -> Generate new connection string.
# DATABASE_URL = alamat "pooled" (dipakai website saat berjalan)
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/?sslmode=require"

# DIRECT_URL = alamat "direct" (dipakai Prisma CLI untuk migrate & seed)
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/?sslmode=require"

# akun login dashboard admin
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="sagu123"

# kunci penanda tangan cookie sesi admin.
SESSION_SECRET="ganti-dengan-teks-acak-yang-panjang"
